import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
---
<Base title="Join the letter" description="One Truth to Live By: one useful idea, thoughtfully explored and distilled into something you can actually use."><div class="wrap"><header class="page-intro center"><span class="eyebrow">ONE IDEA. ROOM TO THINK.</span><h1>A little perspective<br/><em>for your everyday.</em></h1><p class="lede">Something worth understanding. Something to try. A letter to return to when you need a moment of clarity.</p></header><div class="section"><Newsletter/></div><div class="prose-page"><h2>What to expect.</h2><p>A useful idea from philosophy, psychology, relationships or human performance, explored with enough context to make sense and enough care to acknowledge its limits.</p><p>Each letter aims to leave you with a practical reflection: a question to ask, a perspective to consider, or a small experiment in daily life.</p><p>There is no promise to change everything. Just an invitation to understand one thing a little better.</p><h2>Your inbox, your choice.</h2><p>When signup opens, subscribing will be optional. You will be able to unsubscribe through any newsletter email. We will explain the service used and how subscriber details are handled in our <a href="/privacy/">Privacy Notice</a> before collecting email addresses.</p></div></div></Base>
