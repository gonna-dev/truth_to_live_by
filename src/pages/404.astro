---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="This page could not be found. Return home or explore the ideas at Truth to Live By."
  noindex
>
  <section class="wrap error-page">
    <span class="eyebrow">404 / A SMALL DETOUR</span>
    <h1>
      Not every path
      <br />
      <em>leads where we expect.</em>
    </h1>
    <p>
      This page may have moved, or the address may be incomplete. There’s still plenty to explore.
    </p>
    <div class="error-actions">
      <a class="button" href="/">
        Return home →
      </a>
      <a class="text-link" href="/ideas/">
        Browse Ideas
      </a>
      <a class="text-link" href="/watch/">
        Watch
      </a>
    </div>
  </section>
</Base>
