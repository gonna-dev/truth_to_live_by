---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { library } from '../lib/content';
import { brand } from '../config/brand';
const { articles, videos } = await library();
---
<Base title="Watch" description="Watch Truth to Live By on YouTube. Explore philosophy, psychology, relationships and living well through thoughtful videos and Shorts."><div class="wrap"><header class="page-intro"><span class="eyebrow">IDEAS, ON SCREEN</span><h1>A different way<br/><em>to see things.</em></h1><p class="lede">Explore the questions behind a more thoughtful life, one video at a time.</p></header><section class="content-section watch-channel"><div class="watch-art" aria-hidden="true"><div class="watch-ring"></div><span class="watch-play">▶</span><span class="watch-art-label">TRUTH TO LIVE BY / ON SCREEN</span></div><div><span class="eyebrow">OUR YOUTUBE CHANNEL</span><h2>Meet an idea.<br/>Stay for the question.</h2><p>Find our videos and Shorts on YouTube. Each is another way into the subjects we explore here.</p><a class="button" href={brand.youtube}>Watch on YouTube <span aria-hidden="true">↗</span></a><p class="small">Videos open on YouTube. No video player loads here automatically.</p></div></section>{videos.length > 0 ? <section class="content-section"><div class="section-heading"><h2>Selected viewing.</h2></div><div class="video-grid">{videos.map((video) => <VideoCard video={video} relatedSlug={articles.find((a) => a.id === video.data.related_article?.id)?.data.slug}/>)}</div></section> : <section class="content-section"><div class="empty-state"><h2>The watch library is taking shape.</h2><p>We’re selecting videos to pair with the ideas on this site. You can explore the channel now.</p><a class="text-link" href={brand.youtube}>Explore the channel ↗</a></div></section>}<Newsletter/></div></Base>
