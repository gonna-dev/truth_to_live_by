---
import Base from '../layouts/Base.astro';
import { validEmail } from '../lib/integrations.mjs';
import { brand } from '../config/brand';
const email = validEmail(import.meta.env.PUBLIC_CONTACT_EMAIL);
---
<Base title="Contact" description="Get in touch with Truth to Live By about an idea, a correction, a collaboration or a commercial enquiry."><div class="wrap"><header class="page-intro"><span class="eyebrow">KEEP THE CONVERSATION OPEN</span><h1>Something on<br/><em>your mind?</em></h1><p class="lede">Thoughtful correspondence is welcome. Tell us what you’ve noticed, what you’re exploring, or how we might work together.</p></header><div class="prose-page"><div class="contact-options"><div><h2>Ideas &amp; corrections</h2><p>Share a question, suggest a source or flag something that needs another look. For corrections, include the article link and the relevant passage.</p></div><div><h2>Work with us</h2><p>For collaborations, media or commercial enquiries, include a short outline and the best way to reach you.</p></div></div>{email ? <><a class="button" href={`mailto:${email}`}>Email Truth to Live By ↗</a><p class="small">Your email app will open. Please avoid sending sensitive personal information. <a href="/privacy/">Read our Privacy Notice</a>.</p></> : <div class="empty-state"><h2>Our inbox is being set up.</h2><p>The dedicated contact address will appear here before launch. For now, find the brand on Instagram.</p><a class="text-link" href={brand.instagram}>Visit our Instagram profile ↗</a></div>}</div></div></Base>
