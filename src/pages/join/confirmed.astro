---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Subscription confirmed"
  description="Your subscription to One Truth to Live By is confirmed."
  noindex
>
  <div class="wrap">
    <header class="page-intro center">
      <span class="eyebrow">YOU’RE ON THE LIST</span>
      <h1>
        A little perspective
        <br />
        <em>is on its way.</em>
      </h1>
      <p class="lede">
        Your subscription to One Truth to Live By is confirmed. Thank you for making room for one
        useful idea at a time.
      </p>
    </header>
    <div class="prose-page confirmation-page">
      <div class="empty-state">
        <h2>What happens next?</h2>
        <p>
          New letters will arrive from Truth to Live By. If the first one does not appear, check
          Promotions or Spam and add the sender to your contacts.
        </p>
        <p>You can unsubscribe at any time using the link included in every newsletter.</p>
        <a class="button" href="/ideas/">Explore the latest Ideas</a>
      </div>
    </div>
  </div>
</Base>
