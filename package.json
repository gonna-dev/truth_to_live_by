{
  "name": "truth-to-live-by",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:site": "node scripts/check-site.mjs",
    "test:browser": "playwright test",
    "validate": "npm run check && npm test && npm run build && npm run test:site",
    "release:check": "node scripts/release-check.mjs",
    "build:release": "npm run validate && npm run release:check",
    "build:cloudflare": "node scripts/cloudflare-build.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
